# Neon / Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Shared password for the /admin login form
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie (32+ random characters)
AUTH_SECRET=generate-a-long-random-string

# Workiz Developer API token (Settings → Integrations). Placed in the URL path.
WORKIZ_API_TOKEN=

# Optional Workiz API secret. Not sent on GET /job/all/ (Developer API).
# Reserved for future POST writes as JSON auth_secret. Do not put this in ?secret=.
WORKIZ_AUTH_SECRET=

# Optional lookback window for GET /job/all/?start_date= (days). Default 365.
# WORKIZ_LOOKBACK_DAYS=365

# Shared secret for GET /api/cron/sync (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate-a-long-random-string
