# Neon / Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Shared password for the /admin login form
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie (32+ random characters)
AUTH_SECRET=generate-a-long-random-string

# Workiz Developer API token (Settings → Integrations). Placed in the URL path.
WORKIZ_API_TOKEN=

# Optional Workiz API secret. Default Developer API mode does NOT send ?secret=
# (unknown param → likely HTTP 400 on /job/all/). Set WORKIZ_API_MODE=easy to
# append it, which is Easy API / Zapier style.
WORKIZ_AUTH_SECRET=
# WORKIZ_API_MODE=easy

# Optional lookback window for GET /job/all/?start_date= (days). Default 730 (~2y).
# WORKIZ_LOOKBACK_DAYS=730

# Shared secret for GET /api/cron/sync (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate-a-long-random-string
